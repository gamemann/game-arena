/addons/dot_combat
/addons/dot_loadout
/addons/dot_match
/addons/dot_ui
/addons/dot_map
/addons/dot_leaderboard
/addons/dot_stats
/addons/dot_achievements
/addons/dot_vote
/addons/dot_props
/addons/dot_npc
/addons/dot_npc_ai
/addons/dot_npc_ai_director
/addons/dot_auth
/addons/dot_browser
/addons/dot_chat
/addons/dot_cloud
/addons/dot_moderation
/addons/dot_platform
/addons/dot_user
/addons/dot_user_avatar
/addons/dot_voice
/addons/dot_weapon

# The imported maps: the g2gfast-maps repository, linked here by dot-bootstrap off the
# comment line below (copied, on Windows), at the same path game-g2gfast links it, so the
# `.import` markers in it are right for both games. Arena plays the ones whose manifest says
# "kind": "arena" (combat surf maps); a checkout without the link plays the three built-in
# maps, which is a supported state, not a broken one.
# bootstrap-link: g2gfast-maps/maps
/maps/imported

# dot-cloud mounts packs here; headless_imported writes a fake one and deletes it.
/dot_cloud/

# Exports
build/
export_presets.cfg

# OS
.DS_Store
Thumbs.db

# Screenshots are evidence for a review, not assets.
/screenshots/
/addons/dot_objective
